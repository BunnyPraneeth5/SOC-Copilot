# =============================================================================
# SOC Copilot - Environment Configuration
# =============================================================================
# Keep this file local. Do not commit real API keys or secrets.
# Replace placeholder API values before enabling online enrichment.
# =============================================================================

# --- Core Paths ---
SOC_COPILOT_MODELS_DIR=data/models
SOC_COPILOT_LOG_DIR=logs
SOC_COPILOT_CONFIG_DIR=config

# --- Security / Safety ---
# Production-safe default: verify model hashes before loading serialized models.
SOC_COPILOT_STRICT_MODEL_INTEGRITY=true

# Keep offline by default. Set to true only after API keys below are configured.
SOC_COPILOT_ENABLE_ONLINE_ENRICHMENT=false

# --- Threat Intelligence API Keys ---
# AbuseIPDB: https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=replace_with_your_abuseipdb_api_key

# VirusTotal: https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=replace_with_your_virustotal_api_key

# Shodan: https://account.shodan.io/
SHODAN_API_KEY=replace_with_your_shodan_api_key

# --- LLM / Report Agent Configuration ---
# LLM Provider for generating threat reports. Valid values: nvidia_nim, openrouter
REPORT_LLM_PROVIDER=nvidia_nim

# NVIDIA NIM Configuration (Default)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct

# OpenRouter Configuration (Alternative)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct:free

# --- System Log Ingestion ---
# Windows Event Log ingestion may require running as administrator.
SOC_COPILOT_SYSTEM_LOGS_ENABLED=true
SOC_COPILOT_EXPORT_INTERVAL=5

# --- Logging ---
# Valid values: DEBUG, INFO, WARNING, ERROR
SOC_COPILOT_LOG_LEVEL=INFO

# --- UI ---
# Valid values: dark, light
SOC_COPILOT_THEME=dark

# --- Optional ML Threshold Overrides ---
# Leave commented to use config files/defaults.
# SOC_COPILOT_ANOMALY_LOW_THRESHOLD=0.3
# SOC_COPILOT_ANOMALY_HIGH_THRESHOLD=0.7
# SOC_COPILOT_PRIORITY_CRITICAL=0.85
# SOC_COPILOT_PRIORITY_HIGH=0.70
# SOC_COPILOT_PRIORITY_MEDIUM=0.50
# SOC_COPILOT_PRIORITY_LOW=0.30
